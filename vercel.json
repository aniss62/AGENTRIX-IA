{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/produit",
      "destination": "/produit/",
      "permanent": true
    },
    {
      "source": "/a-propos",
      "destination": "/a-propos/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/confidentialite",
      "destination": "/confidentialite/",
      "permanent": true
    },
    {
      "source": "/cookies",
      "destination": "/cookies/",
      "permanent": true
    },
    {
      "source": "/conditions",
      "destination": "/conditions/",
      "permanent": true
    }
  ]
}
